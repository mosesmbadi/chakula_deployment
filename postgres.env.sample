### Shared Postgres — copy to postgres.env on the server
# Superuser for administration only; apps connect with their own roles.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-password>
POSTGRES_DB=postgres

# Per-app role passwords, used by postgres/init on first start.
# Must match the password in that app's DATABASE_URL.
AQUACHECK_DB_PASSWORD=<strong-password>
