{
	order rate_limit before reverse_proxy
}

(rate_limited) {
	rate_limit {
		zone {args[0]} {
			key    {remote_host}
			events 30
			window 10s
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

securevisionrealty.com, www.securevisionrealty.com {
	import rate_limited sv_frontend

	handle /api/* {
		reverse_proxy secure_vision_backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /uploads/* {
		reverse_proxy secure_vision_backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /sitemap.xml {
		reverse_proxy secure_vision_backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy secure_vision_frontend:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	import security_headers

	log {
		output file /var/log/caddy/secure_vision.log
		format json
	}
}

imaralegacy.org, www.imaralegacy.org {
	import rate_limited imara

	reverse_proxy imara_legacy_web:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	import security_headers

	log {
		output file /var/log/caddy/imara_legacy.log
		format json
	}
}
