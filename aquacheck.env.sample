### AquaCheck LIMS — copy to aquacheck.env on the server
# Read by aquacheck_migrations and aquacheck_backend.

# ─── Database ─────────────────────────────────────────────────
# Password must match AQUACHECK_DB_PASSWORD in postgres.env.
DATABASE_URL=postgresql://aquacheck:<strong-password>@postgres:5432/aquacheck

# ─── Auth ─────────────────────────────────────────────────────
SECRET_KEY=<long-random-string>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Seeded accounts ──────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
ADMIN3_EMAIL=
ADMIN3_PASSWORD=
# Leave blank to have one generated and printed once in the backend startup log.
STAFF_DEFAULT_PASSWORD=

# ─── App ──────────────────────────────────────────────────────
# Public-facing base URL for QR code links in reports
PUBLIC_BASE_URL=https://lims.aquachecklab.com
DEFAULT_VAT_RATE=16
# Last sample number issued by the paper register (e.g. 165 for QT/165/2026).
SAMPLE_CODE_START_AFTER=0

# ─── SMTP (for quotation emails) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=AquaCheck Laboratories
SMTP_USE_TLS=true
SMTP_USE_SSL=false
